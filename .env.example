# Kedai Kenshin — contoh konfigurasi environment
# Salin ke .env (di VPS: /var/www/kedaikenshin.com/shared/.env),
# lalu isi nilainya. JANGAN commit file .env asli ke git.
#
# Cara pakai:
#   cp .env.example .env        (lokal, untuk dev server)
#   # di VPS: simpan di shared/.env agar persisten antar deploy

# ── Storage driver: 'local' atau 'r2' ───────────────────────
# local = simpan di images/menu/ VPS (perilaku lama, default aman)
# r2    = upload ke Cloudflare R2 + optimasi resize/WebP otomatis
STORAGE_DRIVER=local

# ── Cloudflare R2 (wajib diisi bila STORAGE_DRIVER=r2) ──────
# R2_ACCOUNT_ID        = 32 karakter hex di URL dashboard R2
# R2_ACCESS_KEY_ID     = dari R2 > Manage API tokens
# R2_SECRET_ACCESS_KEY = hanya tampil sekali saat dibuat — simpan baik-baik
# R2_BUCKET            = nama bucket, mis. kedaikenshin-media
# R2_ENDPOINT          = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#                        (boleh dikosongkan — otomatis dari ACCOUNT_ID)
# R2_REGION            = biarkan 'auto' untuk R2
# R2_PUBLIC_BASE_URL   = URL publik file. Pilih SALAH SATU:
#   a) Custom domain (disarankan): https://cdn.kedaikenshin.com
#      (hubungkan domain ke bucket via dashboard R2 > Custom Domains)
#   b) Dev URL R2: https://<bucket>.<account>.r2.dev
#      (aktifkan "Allow Access" / r2.dev subdomain di dashboard)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kedaikenshin-media
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# ── Optimasi gambar (berlaku untuk local & r2) ───────────────
# IMAGE_MAX_WIDTH    = lebar maksimum foto menu (px), sisanya di-resize
# IMAGE_WEBP_QUALITY = kualitas WebP 50-100 (disarankan 80-85)
# IMAGE_MAX_MB       = batas upload (MB), sinkron dengan validasi admin
IMAGE_MAX_WIDTH=1600
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_MB=5
